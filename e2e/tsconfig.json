{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["tests/**/*", "fixtures/**/*", "playwright.config.ts"]
}
