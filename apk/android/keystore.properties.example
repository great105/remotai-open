# Release signing config for TGControl APK/AAB.
# Copy this file to android/keystore.properties and fill in real values.
# NEVER commit the real keystore.properties or the .keystore file.
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore tgcontrol-release.keystore \
#     -alias tgcontrol -keyalg RSA -keysize 2048 -validity 10000 \
#     -storetype PKCS12
#
# storeFile is resolved relative to the android/ directory.
storeFile=tgcontrol-release.keystore
storePassword=CHANGE_ME
keyAlias=tgcontrol
keyPassword=CHANGE_ME
